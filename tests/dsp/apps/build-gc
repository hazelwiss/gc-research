include ../../../common/build.mk
build: dsp-test-all.iso dsp-test-nop.dol 
dsp-test-nop.dol: dsp-test-nop.elf
dsp-test-nop.elf: dsp-test-nop.o
dsp-test-all.iso: dsp-test-all.dol nop.bin 
dsp-test-all.dol: dsp-test-all.elf
dsp-test-all.elf: dsp-test-all.o
package: build
	@mkdir -p $(PACKAGE_DIR)/dsp
	@cp dsp-test-nop.dol $(PACKAGE_DIR)/dsp/dsp-test-nop.dol
	@cp dsp-test-all.dol $(PACKAGE_DIR)/dsp/dsp-test-all.dol
